# OmniSight 配置模板
# 用法：复制为 .env 再按需修改 —— `cp .env.example .env`（PowerShell: Copy-Item .env.example .env）
# 运行 `live-vlm-webui`（不带参数）即会读取项目根目录的 .env。
# 优先级：命令行参数 > .env > 内置默认值。
# 注意：.env 含密钥，已被 .gitignore 忽略，不要提交；本模板（.env.example）不含真实密钥，可入库。

# ── 服务监听 ──
LIVE_VLM_HOST=0.0.0.0          # 监听地址，0.0.0.0 = 局域网可访问
LIVE_VLM_PORT=8091            # 端口

# ── SSL（可选）──
# 有证书走 HTTPS；无证书会自动回退 HTTP（局域网够用，浏览器不再因 getUserMedia 强制 HTTPS）。
# 相对项目根目录；缺失时若装了 openssl/cryptography 会尝试自动生成自签证书。
LIVE_VLM_SSL_CERT=cert.pem
LIVE_VLM_SSL_KEY=key.pem

# ── VLM 后端（OpenAI 兼容）──
# 云端 NVIDIA API Catalog：
LIVE_VLM_API_BASE=https://integrate.api.nvidia.com/v1
LIVE_VLM_DEFAULT_MODEL=meta/llama-3.2-90b-vision-instruct
LIVE_VLM_API_KEY=YOUR_API_KEY_HERE     # 在 https://build.nvidia.com/settings/api-keys 生成；切勿提交真实 key
# 本地后端示例（Ollama）：把上面三行改为：
#   LIVE_VLM_API_BASE=http://localhost:11434/v1
#   LIVE_VLM_DEFAULT_MODEL=llava:7b
#   LIVE_VLM_API_KEY=EMPTY

# ── 推理并发限流（InferencePool，可选）──
# 全局最多同时进行的 VLM 推理数；多路摄像头时防止打爆后端。默认 2，按后端能力压测调整。
LIVE_VLM_MAX_CONCURRENCY=2

# ── 代理隔离（关键，按需）──
# 若本机开了 Clash 等系统代理（如 127.0.0.1:7890），局域网摄像头/边缘设备必须直连、不走代理，
# 否则 FFmpeg 会把请求丢给代理导致视频连不上；而公网 VLM API 仍走代理。
# 把局域网设备 IP 追加到下面两行（FFmpeg 只认具体 IP，不支持网段写法）。无代理可删掉这两行。
NO_PROXY=172.101.6.168,127.0.0.1,localhost
no_proxy=172.101.6.168,127.0.0.1,localhost
